# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# Your bot's username (without @), used to build invite links
BOT_USERNAME=EverTree3DBot

# Public HTTPS URL of the deployed Streamlit Mini App
WEBAPP_URL=https://your-streamlit-app-url.example.com

# PostgreSQL connection string (SQLAlchemy). Falls back to local SQLite if unset.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/evertree3d
